PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# For local SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smartway?schema=public"
JWT_SECRET="smartway-super-secret-jwt-key-2026-production-ready"
JWT_EXPIRES_IN="7d"

# AWS S3 Storage (Notes and PDFs)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="smartway-assets"

# Cloudflare Stream (Micro-learning Reels)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

